    "name": "CinemaStar Production Smoke Tests",
    "description": "Read-only and guarded mutation smoke tests for the CinemaStar production gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.environment.set('runTimestamp', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is below 500', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "const contentType = pm.response.headers.get('Content-Type') || '';",
          "if (contentType.includes('application/json')) {",
          "  const json = pm.response.json();",
          "  if (Object.prototype.hasOwnProperty.call(json, 'success')) {",
          "    pm.test('API wrapper success is true', function () {",
          "      pm.expect(json.success).to.eql(true);",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "ReadOnly Smoke",
      "item": [
        {
          "name": "01 Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Admin auth cookies are issued', function () {",
                  "  const setCookie = pm.response.headers.all().filter(header => String(header.key).toLowerCase() === 'set-cookie').map(header => header.value).join('; ');",
                  "  pm.expect(setCookie).to.include('accessToken=');",
                  "  pm.expect(setCookie).to.include('refreshToken=');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Film Search - Capture Film",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"size\": 12,\n  \"sortBy\": [\n    {\n      \"field\": \"TIME_CREATED\",\n      \"direction\": \"DESC\"\n    }\n  ],\n  \"filterBy\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/films/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "films",
                "search"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const rows = pm.response.json().data && pm.response.json().data.data ? pm.response.json().data.data : [];",
                  "pm.test('Film search returns at least one film', function () {",
                  "  pm.expect(rows.length).to.be.above(0);",
                  "});",
                  "if (rows.length > 0) {",
                  "  const film = rows.find(item => item && item.id) || rows[0];",
                  "  pm.environment.set('filmId', film.id);",
                  "  pm.test('Film has rating summary fields', function () {",
                  "    pm.expect(film).to.have.property('averageRating');",
                  "    pm.expect(film).to.have.property('reviewCount');",
                  "    pm.expect(film.averageRating).to.not.eql(null);",
                  "    pm.expect(film.reviewCount).to.not.eql(null);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Film Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/films/{{filmId}}",
