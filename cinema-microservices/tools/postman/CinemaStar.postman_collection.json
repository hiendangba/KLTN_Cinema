        {
          "name": "04 Showtime Search - Capture Showtime",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"size\": 12,\n  \"sortBy\": [\n    {\n      \"field\": \"START_DATE_TIME\",\n      \"direction\": \"DESC\"\n    }\n  ],\n  \"filterBy\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/showtimes/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "showtimes",
                "search"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const rows = pm.response.json().data && pm.response.json().data.data ? pm.response.json().data.data : [];",
                  "pm.test('Showtime search returns at least one showtime', function () {",
                  "  pm.expect(rows.length).to.be.above(0);",
                  "});",
                  "if (rows.length > 0) {",
                  "  const showtime = rows.find(item => item && item.id && item.filmId && item.startDateTime) || rows[0];",
                  "  pm.environment.set('showtimeId', showtime.id);",
                  "  pm.environment.set('filmId', showtime.filmId || pm.environment.get('filmId'));",
                  "  pm.environment.set('showtimeDate', String(showtime.startDateTime).substring(0, 10));",
                  "  if (showtime.hall && showtime.hall.id) pm.environment.set('hallId', showtime.hall.id);",
                  "  if (showtime.hall && showtime.hall.cinemaId) pm.environment.set('cinemaId', showtime.hall.cinemaId);",
                  "  pm.test('Showtime has film, hall and capacity data', function () {",
                  "    pm.expect(showtime.filmId).to.be.ok;",
                  "    pm.expect(showtime.hallId || (showtime.hall && showtime.hall.id)).to.be.ok;",
                  "    pm.expect(showtime.totalSeatCapacity).to.not.eql(null);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
